export default async function handler(req, res) {
  const { query } = req.query;

  if (!query) {
    return res.status(400).json({ success: false, msg: "Query parameter missing" });
  }

  try {
    const apiUrl = `https://rootx-osint.in/?type=tg_num&key=FREE_API&query=${encodeURIComponent(query)}`;
    const response = await fetch(apiUrl);
    const data = await response.json();

    return res.status(200).json(data);
  } catch (error) {
    return res.status(500).json({ success: false, msg: "Backend fetch failed" });
  }
}
